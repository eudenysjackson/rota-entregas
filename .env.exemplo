# Configuração do Rota de Entregas (Desktop)
# Renomeie este arquivo para ".env" e preencha os valores abaixo.
# O arquivo .env deve ficar na mesma pasta que o RotaEntregas.exe

# Chave da API do Google (obrigatório para buscar clientes)
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=SUA_CHAVE_AQUI

# ID da planilha Google Sheets (já preenchido com o padrão)
ID_PLANILHA_BASE=16aLq8UzMfWs78ewzGCmKvM_7DjL5IO7MqUce0BPb9SE

# Nome da aba na planilha
NOME_ABA_BASE=novo
